<?php $this->start("endScripts") ?>
<script>
    (function () {
        var el = document.getElementById("calendario");
        if (!el || typeof FullCalendar === "undefined") return;

        var urlEventos = "<?=$router->route("admin.calendario.eventos")?>";
        var urlPreferencia = "<?=$router->route("admin.calendario.preferencia.eventos")?>";
        var urlEditarLembreteBase = "<?=$router->route("admin.calendario.lembrete.editar", ["id" => "__ID__"])?>";
        var urlNovoLembreteBase = "<?=$router->route("admin.calendario.lembrete.novo", ["data" => "__DATA__"])?>";
        var csrfToken = "<?=$csrf?>";
        var podeInserirLembrete = <?=!empty($permissao["inserir"]) ? "true" : "false"?>;

        var podeEditarLembrete = <?=!empty($permissao["editar"]) ? "true" : "false"?>;
        var podeEditarTrato = <?=!empty($permissao["editar_trato"]) ? "true" : "false"?>;
        var podeEditarValidade = <?=!empty($permissao["editar_validade"]) ? "true" : "false"?>;
        var podeArrastarAlgumTipo = podeEditarLembrete || podeEditarTrato || podeEditarValidade;

        // config de "mover" por tipo de evento: url do endpoint, nome
        // do campo de data esperado no POST, e se o usuário atual tem
        // permissão de editar aquele tipo específico.
        var moverConfigPorTipo = {
            lembrete: { url: "<?=$router->route("admin.calendario.lembrete.mover")?>", campoData: "data_lembrete", pode: podeEditarLembrete },
            trato: { url: "<?=$router->route("admin.calendario.programacao.trato.mover")?>", campoData: "data", pode: podeEditarTrato },
            validade: { url: "<?=$router->route("admin.calendario.validade.insumo.mover")?>", campoData: "data", pode: podeEditarValidade }
        };

        var iconePorTipo = {
            trato: "uil-utensils",
            carencia: "uil-shield-exclamation",
            validade: "uil-calendar-exclamation",
            lembrete: "uil-bell"
        };

        var calendarioVisao = "<?=$calendario_visao?>";

        var calendar = new FullCalendar.Calendar(el, {
            locale: "pt-br",
            height: "auto",
            initialView: calendarioVisao,
            headerToolbar: {
                left: "prev,next today",
                center: "title",
                right: "dayGridMonth,dayGridWeek"
            },
            editable: podeArrastarAlgumTipo,
            eventStartEditable: podeArrastarAlgumTipo,
            dateClick: function (info) {
                if (!podeInserirLembrete) return;
                window.location.href = urlNovoLembreteBase.replace("__DATA__", info.dateStr);
            },
            eventAllow: function (dropInfo, draggedEvent) {
                // carência sanitária nunca é arrastável (é um valor
                // calculado, não um campo direto) -- os demais tipos só
                // são arrastáveis se o usuário tiver permissão de editar
                // aquele módulo específico.
                var config = moverConfigPorTipo[draggedEvent.extendedProps.tipo];
                return !!(config && config.pode);
            },
            eventDrop: function (info) {
                var props = info.event.extendedProps;
                var config = moverConfigPorTipo[props.tipo];
                var novaData = info.event.startStr.substring(0, 10);

                if (!config) {
                    info.revert();
                    return;
                }

                var payload = { csrf: csrfToken, id: props.hash };
                payload[config.campoData] = novaData;

                $.ajax({
                    url: config.url,
                    method: "POST",
                    dataType: "json",
                    data: payload
                }).done(function (resp) {
                    if (resp && resp.error) {
                        info.revert();
                    }
                }).fail(function () {
                    info.revert();
                });
            },
            events: function (info, successCallback, failureCallback) {
                var tiposAtivos = [];
                document.querySelectorAll(".calendario-filtro:checked").forEach(function (cb) {
                    tiposAtivos.push(cb.value);
                });
                $.ajax({
                    url: urlEventos,
                    method: "GET",
                    dataType: "json",
                    data: {
                        data_inicial: info.startStr.substring(0, 10),
                        data_final: info.endStr.substring(0, 10)
                    }
                }).done(function (resp) {
                    var eventos = (resp && resp.data ? resp.data : []).filter(function (e) {
                        return tiposAtivos.indexOf(e.tipo) !== -1;
                    }).map(function (e) {
                        return {
                            title: e.titulo,
                            start: e.data,
                            allDay: true,
                            classNames: ["fc-evento-" + e.tipo, e.concluido ? "concluido" : ""],
                            extendedProps: e
                        };
                    });
                    successCallback(eventos);
                }).fail(function () {
                    failureCallback();
                });
            },
            eventClick: function (info) {
                var props = info.event.extendedProps;
                var modalEl = document.getElementById("modal-evento");

                document.getElementById("modal-evento-titulo").innerHTML =
                    '<i class="uil ' + (iconePorTipo[props.tipo] || "uil-calendar-alt") + '"></i> ' + info.event.title;
                document.getElementById("modal-evento-data").textContent =
                    new Date(props.data + "T00:00:00").toLocaleDateString("pt-BR");
                document.getElementById("modal-evento-detalhe").textContent = props.detalhe || "";
                document.getElementById("modal-evento-descricao").textContent = props.descricao || "";

                var linkEl = document.getElementById("modal-evento-link");
                var editarEl = document.getElementById("modal-evento-editar");
                var excluirEl = document.getElementById("modal-evento-excluir");

                if (props.tipo === "lembrete") {
                    linkEl.style.display = "none";
                    <?php if (!empty($permissao["editar"])) : ?>
                    editarEl.style.display = "inline-block";
                    editarEl.href = urlEditarLembreteBase.replace("__ID__", props.hash);
                    <?php endif ?>
                    <?php if (!empty($permissao["excluir"])) : ?>
                    excluirEl.style.display = "inline-block";
                    excluirEl.onclick = function () {
                        Delete("calendario/lembretes/delete", props.hash);
                    };
                    <?php endif ?>
                } else {
                    editarEl.style.display = "none";
                    excluirEl.style.display = "none";
                    if (props.url) {
                        linkEl.style.display = "inline-block";
                        linkEl.href = props.url;
                    } else {
                        linkEl.style.display = "none";
                    }
                }

                new bootstrap.Modal(modalEl).show();
            }
        });

        calendar.render();

        // Carregar preferência salva do usuário
        var eventosPref = "<?=$calendario_eventos?>".split(",");
        document.querySelectorAll(".calendario-filtro").forEach(function (cb) {
            cb.checked = eventosPref.indexOf(cb.value) !== -1;
        });

        // Ao marcar/desmarcar, salvar e recarregar eventos
        document.querySelectorAll(".calendario-filtro").forEach(function (cb) {
            cb.addEventListener("change", function () {
                var ativos = [];
                document.querySelectorAll(".calendario-filtro:checked").forEach(function (c) {
                    ativos.push(c.value);
                });
                $.ajax({
                    url: urlPreferencia,
                    method: "POST",
                    dataType: "json",
                    data: { eventos: ativos.join(","), csrf: csrfToken }
                });
                calendar.refetchEvents();
            });
        });

        // Salvar visão (mês/semana) quando o usuário alternar
        calendar.on("datesSet", function (info) {
            if (info.view.type !== calendarioVisao) {
                calendarioVisao = info.view.type;
                $.ajax({
                    url: urlPreferencia,
                    method: "POST",
                    dataType: "json",
                    data: { visao: calendarioVisao, csrf: csrfToken }
                });
            }
        });
    })();
</script>
<?php $this->end() ?>
