                <a id="modal-evento-editar" href="#" class="btn btn-outline-primary" style="display:none;">Editar lembrete</a>
                <button type="button" id="modal-evento-excluir" class="btn btn-outline-danger" style="display:none;">Excluir lembrete</button>
