<script>
    (function () {
        var el = document.getElementById("grafico-peso-home");
        var vazioEl = document.getElementById("grafico-peso-home-vazio");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var form = document.getElementById("form-grafico-peso-home");
        var url = "<?=$router->route("admin.home.grafico.peso")?>";

        function render(series) {
            if (!series || series.length === 0) {
                el.style.display = "none";
                vazioEl.style.display = "block";
                return;
            }
            el.style.display = "block";
            vazioEl.style.display = "none";

            chart.setOption({
                tooltip: {
                    trigger: "axis",
                    formatter: function (params) {
                        if (!params.length) return "";
                        var linhas = ["<strong>" + window.formatDataBr(params[0].axisValue) + "</strong>"];
                        params.forEach(function (p) {
                            if (p.value[1] === null || p.value[1] === undefined) return;
                            linhas.push(p.marker + " " + p.seriesName + ": " + p.value[1].toLocaleString("pt-BR", { minimumFractionDigits: 2 }) + " kg");
                        });
                        return linhas.join("<br>");
                    }
                },
                legend: { data: series.map(function (s) { return s.nome; }), top: 0 },
                grid: { left: 50, right: 20, top: 40, bottom: 30 },
                xAxis: { type: "time" },
                yAxis: { type: "value", name: "kg", axisLabel: { formatter: "{value} kg" } },
                series: series.map(function (s) {
                    return {
                        name: s.nome,
                        type: "line",
                        smooth: true,
                        connectNulls: true,
                        data: s.pontos.map(function (p) { return [p.data, p.peso_medio]; }),
                    };
                }),
            }, true);
        }

        function load() {
            var params = new URLSearchParams(new FormData(form));
            $.ajax({
                url: url + "?" + params.toString(),
                method: "GET",
                dataType: "json",
            }).done(function (resp) {
                render(resp && resp.data ? resp.data : []);
            });
        }

        form.addEventListener("input", load);
        document.getElementById("btn-limpar-filtro-peso-home").addEventListener("click", function () {
            form.reset();
            load();
        });
        window.addEventListener("resize", function () { chart.resize(); });

        load();
    })();
</script>
<?php $this->end() ?>

