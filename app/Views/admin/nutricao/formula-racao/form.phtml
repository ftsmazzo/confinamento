<script>
    (function () {
        var tbody = document.getElementById("itens-formula-body");
        var template = document.getElementById("template-item-formula-row");
        var btnAdd = document.getElementById("btn-add-item-formula");

        btnAdd.addEventListener("click", function () {
            var clone = template.content.cloneNode(true);
            tbody.appendChild(clone);

            if (window.jQuery && $.fn.select2) {
                var novaLinha = tbody.lastElementChild;
                $(novaLinha).find(".select2").select2({
                    minimumResultsForSearch: 0,
                    width: "100%",
                    theme: "bootstrap-5"
                });
            }
        });

        tbody.addEventListener("click", function (event) {
            var btn = event.target.closest(".btn-remove-item-formula");
            if (btn) {
                btn.closest("tr").remove();
            }
        });
    })();
</script>
