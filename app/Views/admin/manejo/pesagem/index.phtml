<?php $this->layout("app/template/base"); ?>

<?php $this->start("page-actions") ?>
    <?php if ($lote) : ?>
        <a class="btn btn-white btn-sm" href="<?=$router->route("admin.manejo.lote.editar", ["id" => $lote->hash()])?>"><i class="uil uil-left"></i> Voltar ao Lote</a>
    <?php elseif ($animal) : ?>
        <a class="btn btn-white btn-sm" href="<?=$router->route("admin.manejo.animal.editar", ["id" => $animal->hash()])?>"><i class="uil uil-left"></i> Voltar ao Animal</a>
    <?php endif ?>
<?php $this->end() ?>

<?php $this->start("page-buttons") ?>
    <?php if (!empty($permissao["inserir"])) : ?>
        <a class="btn btn-primary" href="<?=$router->route("admin.manejo.pesagem.novo", array_filter(["id_lote" => $lote->id ?? null, "id_animal" => $animal->id ?? null]))?>"><i class="fa fa-plus fa-fw"></i> Nova Pesagem</a>
    <?php endif ?>
<?php $this->end() ?>

<div class="card crud-table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm table-datatable table-datatable-alt crud-table">
                <thead>
                    <tr>
                        <?php if (!$lote && !$animal) : ?>
                            <th>Lote / Animal</th>
                        <?php endif ?>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Peso Médio</th>
                        <th>Peso Total</th>
                        <th>GMD</th>
                        <?php if ($permissao["editar"] || $permissao["excluir"]) : ?>
                            <th class="text-end actions-column"></th>
                        <?php endif ?>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($dados as $d) : ?>
                        <tr>
                            <?php if (!$lote && !$animal) : ?>
                                <td><?=$d->vinculo_print?></td>
                            <?php endif ?>
                            <td><?=datebr($d->data_pesagem)?></td>
                            <td><span class="badge filled-outlined bg-secondary"><?=$d->tipo?></span></td>
                            <td><?=$d->peso_medio !== null ? number_format((float) $d->peso_medio, 2, ",", ".") . " kg" : "-"?></td>
                            <td><?=$d->peso_total !== null ? number_format((float) $d->peso_total, 2, ",", ".") . " kg" : "-"?></td>
                            <td>
                                <?php if ($d->gmd !== null) : ?>
                                    <span class="badge filled-outlined <?=$d->gmd >= 0 ? "bg-success" : "bg-danger"?>"><?=number_format($d->gmd, 3, ",", ".")?> kg/dia</span>
                                <?php else : ?>
                                    <span class="text-muted">-</span>
                                <?php endif ?>
                            </td>
                            <?php if ($permissao["editar"] || $permissao["excluir"]) : ?>
                                <td class="text-end actions-column">
                                    <div class="table-actions">
                                        <?php if ($permissao["editar"]) : ?>
                                            <a class="table-action-btn" data-tooltip="true" title="Editar" href="<?=$router->route("admin.manejo.pesagem.editar", ["id" => $d->hash])?>"><i class="uil-edit-alt"></i></a>
                                        <?php endif ?>
                                        <?php if ($permissao["excluir"]) : ?>
                                            <button type="button" class="table-action-btn table-action-danger" data-tooltip="true" title="Excluir pesagem" onclick="Delete('manejo/pesagens/delete', '<?=$d->hash?>')"><i class="uil uil-trash"></i></button>
                                        <?php endif ?>
                                    </div>
                                </td>
                            <?php endif ?>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
