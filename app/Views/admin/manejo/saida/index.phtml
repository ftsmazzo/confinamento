    <?php endif ?>
<?php $this->end() ?>

<div class="card crud-table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm table-datatable table-datatable-alt crud-table">
                <thead>
                    <tr>
                        <?php if (!$lote) : ?>
                            <th>Lote</th>
                        <?php endif ?>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Cliente</th>
                        <th>Quantidade</th>
                        <th>Peso Total</th>
                        <th>Valor Total</th>
