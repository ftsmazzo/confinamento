                            <th class="text-end actions-column"></th>
                        <?php endif ?>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($dados as $d) : ?>
                        <tr>
                            <?php if (!$lote) : ?>
                                <td><?=$d->vinculo_print?></td>
                            <?php endif ?>
                            <td><?=datebr($d->data_saida)?></td>
                            <td><span class="badge filled-outlined bg-secondary"><?=$d->tipo_saida_descricao ?: "-"?></span></td>
                            <td><?=$d->cliente_razao ?: "-"?></td>
                            <td><?=$d->quantidade !== null ? (int) $d->quantidade : "-"?></td>
                            <td><?=$d->peso_total !== null ? number_format((float) $d->peso_total, 2, ",", ".") . " kg" : "-"?></td>
                            <td><?=$d->valor_total !== null ? "R$ " . number_format((float) $d->valor_total, 2, ",", ".") : "-"?></td>
