                                <td class="text-end actions-column">
                                    <div class="table-actions">
                                        <?php if ($permissao["editar"]) : ?>
                                            <a class="table-action-btn" data-tooltip="true" title="Editar" href="<?=$router->route("admin.manejo.saida.editar", ["id" => $d->hash])?>"><i class="uil-edit-alt"></i></a>
                                        <?php endif ?>
                                        <?php if ($permissao["excluir"]) : ?>
                                            <button type="button" class="table-action-btn table-action-danger" data-tooltip="true" title="Excluir saída" onclick="Delete('manejo/saidas/delete', '<?=$d->hash?>')"><i class="uil uil-trash"></i></button>
                                        <?php endif ?>
                                    </div>
                                </td>
                            <?php endif ?>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
