<?php
    $totalEntrada = 0;
    $totalRacao = 0;
    $totalSanitario = 0;
    $totalReceita = 0;
    $totalCustoComSaida = 0;
    $totalArrobasComSaida = 0;
    $totalCabecasComSaida = 0;
    foreach ($lotes as $l) {
        $totalEntrada += $l->custo_entrada;
        $totalRacao += $l->custo_racao;
        $totalSanitario += $l->custo_sanitario;
        $totalReceita += $l->receita_saida;

        if ($l->tem_saida) {
            $totalCustoComSaida += $l->custo_total;
            $totalArrobasComSaida += $l->peso_saida_kg / 15;
            $totalCabecasComSaida += $l->quantidade_vendida;
        }
    }
    $totalCusto = $totalEntrada + $totalRacao + $totalSanitario;
    $totalResultado = $totalReceita - $totalCusto;
    $custoPorArrobaGeral = $totalArrobasComSaida > 0 ? $totalCustoComSaida / $totalArrobasComSaida : null;
    $custoPorCabecaGeral = $totalCabecasComSaida > 0 ? $totalCustoComSaida / $totalCabecasComSaida : null;
    $margemGeral = $totalReceita > 0 ? $totalResultado / $totalReceita * 100 : null;
?>

