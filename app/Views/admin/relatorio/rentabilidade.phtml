<script>
    (function () {
        var el = document.getElementById("grafico-rentabilidade");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var pontos = <?=json_encode($graficoReceitaDiaria, JSON_UNESCAPED_UNICODE)?>;

        chart.setOption({
            tooltip: {
                trigger: "axis",
                formatter: function (params) {
                    if (!params.length) return "";
                    var linhas = ["<strong>" + window.formatDataBr(params[0].axisValue) + "</strong>"];
                    params.forEach(function (p) {
                        if (p.value[1] === null || p.value[1] === undefined) return;
                        linhas.push(p.marker + " " + p.seriesName + ": R$ " + p.value[1].toLocaleString("pt-BR", { minimumFractionDigits: 2 }));
                    });
                    return linhas.join("<br>");
                }
            },
            legend: { data: ["Receita do dia", "Receita acumulada"], top: 0 },
            grid: { left: 70, right: 20, top: 40, bottom: 30 },
            xAxis: { type: "time" },
            yAxis: { type: "value", name: "R$", axisLabel: { formatter: "R$ {value}" } },
            series: [
                {
                    name: "Receita do dia",
                    type: "line",
                    smooth: true,
                    data: pontos.map(function (p) { return [p.data, p.valor]; }),
                },
                {
                    name: "Receita acumulada",
                    type: "line",
                    smooth: true,
                    areaStyle: {},
                    data: pontos.map(function (p) { return [p.data, p.acumulado]; }),
                },
            ],
        });

        window.addEventListener("resize", function () { chart.resize(); });
    })();
</script>
