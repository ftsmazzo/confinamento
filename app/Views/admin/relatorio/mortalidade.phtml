<script>
    (function () {
        var el = document.getElementById("grafico-mortalidade");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var pontos = <?=json_encode($graficoPerdasDiarias, JSON_UNESCAPED_UNICODE)?>;

        chart.setOption({
            tooltip: {
                trigger: "axis",
                formatter: function (params) {
                    if (!params.length) return "";
                    var p = params[0];
                    return "<strong>" + window.formatDataBr(p.axisValue) + "</strong><br>" + p.marker + " " + p.value[1] + " cabeça(s)";
                }
            },
            grid: { left: 50, right: 20, top: 20, bottom: 30 },
            xAxis: { type: "time" },
            yAxis: { type: "value", name: "cabeças", minInterval: 1 },
            series: [{
                type: "line",
                smooth: true,
                lineStyle: { color: "#dc3545" },
                itemStyle: { color: "#dc3545" },
                areaStyle: { color: "rgba(220, 53, 69, 0.15)" },
                data: pontos.map(function (p) { return [p.data, p.quantidade]; }),
            }],
        });

        window.addEventListener("resize", function () { chart.resize(); });
    })();
</script>
<?php $this->end() ?>
