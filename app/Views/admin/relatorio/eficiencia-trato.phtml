<script>
    (function () {
        var el = document.getElementById("grafico-eficiencia-trato");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var pontos = <?=json_encode($graficoDiario, JSON_UNESCAPED_UNICODE)?>;

        chart.setOption({
            tooltip: {
                trigger: "axis",
                formatter: function (params) {
                    if (!params.length) return "";
                    var linhas = ["<strong>" + window.formatDataBr(params[0].axisValue) + "</strong>"];
                    params.forEach(function (p) {
                        if (p.value[1] === null || p.value[1] === undefined) return;
                        linhas.push(p.marker + " " + p.seriesName + ": " + p.value[1].toLocaleString("pt-BR", { minimumFractionDigits: 2 }) + " kg");
                    });
                    return linhas.join("<br>");
                }
            },
            legend: { data: ["Programado", "Fornecido"], top: 0 },
            grid: { left: 60, right: 20, top: 40, bottom: 30 },
            xAxis: { type: "time" },
            yAxis: { type: "value", name: "kg", axisLabel: { formatter: "{value} kg" } },
            series: [
                {
                    name: "Programado",
                    type: "line",
                    smooth: true,
                    lineStyle: { type: "dashed" },
                    data: pontos.map(function (p) { return [p.data, p.previsto]; }),
                },
                {
                    name: "Fornecido",
                    type: "line",
                    smooth: true,
                    areaStyle: {},
                    data: pontos.map(function (p) { return [p.data, p.realizado]; }),
                },
            ],
        });

        window.addEventListener("resize", function () { chart.resize(); });
    })();
</script>
<?php $this->end() ?>
