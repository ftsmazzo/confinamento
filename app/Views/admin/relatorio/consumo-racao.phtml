<script>
    (function () {
        var el = document.getElementById("grafico-consumo-racao");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var pontos = <?=json_encode($graficoConsumoDiario, JSON_UNESCAPED_UNICODE)?>;

        chart.setOption({
            tooltip: {
                trigger: "axis",
                formatter: function (params) {
                    if (!params.length) return "";
                    var p = params[0];
                    return "<strong>" + window.formatDataBr(p.axisValue) + "</strong><br>" + p.marker + " " + p.value[1].toLocaleString("pt-BR", { minimumFractionDigits: 2 }) + " kg";
                }
            },
            grid: { left: 60, right: 20, top: 20, bottom: 30 },
            xAxis: { type: "time" },
            yAxis: { type: "value", name: "kg", axisLabel: { formatter: "{value} kg" } },
            series: [{
                type: "line",
                smooth: true,
                areaStyle: {},
                data: pontos.map(function (p) { return [p.data, p.quantidade]; }),
            }],
        });

        window.addEventListener("resize", function () { chart.resize(); });
    })();
</script>
<?php $this->end() ?>
<?php endif ?>
