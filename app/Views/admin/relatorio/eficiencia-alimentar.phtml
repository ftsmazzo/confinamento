<script>
    (function () {
        var el = document.getElementById("grafico-eficiencia-alimentar");
        if (!el || typeof echarts === "undefined") return;

        var chart = echarts.init(el, null, { locale: "PT-BR" });
        var linhas = <?=json_encode($linhas, JSON_UNESCAPED_UNICODE)?>.filter(function (l) { return l.conversao_alimentar !== null; });

        chart.setOption({
            tooltip: {
                trigger: "axis",
                axisPointer: { type: "shadow" },
                formatter: function (params) {
                    if (!params.length) return "";
                    var p = params[0];
                    return "<strong>" + p.name + "</strong><br>" + p.marker + " CA: " + p.value.toLocaleString("pt-BR", { minimumFractionDigits: 2 }) + " : 1";
                }
            },
            grid: { left: 120, right: 40, top: 20, bottom: 30 },
            xAxis: { type: "value", name: "CA (kg ração / kg ganho)" },
            yAxis: { type: "category", data: linhas.map(function (l) { return l.nome; }) },
            series: [{
                type: "bar",
                data: linhas.map(function (l) { return l.conversao_alimentar; }),
                itemStyle: { color: "#20c997" },
                label: { show: true, position: "right", formatter: function (p) { return p.value.toLocaleString("pt-BR", { minimumFractionDigits: 2 }); } },
            }],
        });

        window.addEventListener("resize", function () { chart.resize(); });
    })();
</script>
<?php $this->end() ?>
<?php endif ?>
