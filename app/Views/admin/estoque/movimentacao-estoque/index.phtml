                                        <?php if ($permissao["excluir"]) : ?>
                                            <button type="button" class="table-action-btn table-action-danger" data-tooltip="true" title="Excluir movimentação (estorna saldo)" onclick="Delete('estoque/movimentacoes/delete', '<?=$d->hash?>')"><i class="uil uil-trash"></i></button>
                                        <?php endif ?>
                                    </div>
