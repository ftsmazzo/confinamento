            <table class="table table-striped table-hover table-sm table-datatable table-datatable-alt crud-table">
                <thead>
                    <tr>
                        <?php if (!$produto) : ?>
                            <th>Produto</th>
                        <?php endif ?>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Lote</th>
                        <th>Quantidade</th>
