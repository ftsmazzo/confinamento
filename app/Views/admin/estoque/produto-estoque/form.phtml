<script>
    (function () {
        var tiposSanitarios = ["MEDICAMENTO", "VACINA", "SUPLEMENTO"];
        var select = document.getElementById("tipo_produto");
        var secao = document.getElementById("secao-dados-sanitarios");

        function toggleSecaoSanitaria() {
            var mostrar = tiposSanitarios.indexOf(select.value) !== -1;
            secao.style.display = mostrar ? "" : "none";
        }

        select.addEventListener("change", toggleSecaoSanitaria);
        toggleSecaoSanitaria();
    })();
</script>
