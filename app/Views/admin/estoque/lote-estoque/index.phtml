<?php $this->layout("app/template/base"); ?>

<?php $this->start("page-actions") ?>
    <?php if ($produto) : ?>
        <a class="btn btn-white btn-sm" href="<?=$router->route("admin.estoque.produto.editar", ["id" => $produto->hash()])?>"><i class="uil uil-left"></i> Voltar ao Produto</a>
    <?php endif ?>
<?php $this->end() ?>

<?php $this->start("page-buttons") ?>
    <?php if (!empty($permissao["inserir"])) : ?>
        <a class="btn btn-primary" href="<?=$router->route("admin.estoque.lote.novo", array_filter(["id_produto" => $produto->id ?? null]))?>"><i class="fa fa-plus fa-fw"></i> Novo Lote</a>
    <?php endif ?>
<?php $this->end() ?>

<div class="card crud-table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm table-datatable table-datatable-alt crud-table">
                <thead>
                    <tr>
                        <?php if (!$produto) : ?>
                            <th>Produto</th>
                        <?php endif ?>
                        <th>Código do Lote</th>
                        <th>Validade</th>
                        <th>Quantidade Atual</th>
                        <?php if ($permissao["editar"] || $permissao["excluir"]) : ?>
                            <th class="text-end actions-column"></th>
                        <?php endif ?>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($dados as $d) : ?>
                        <tr>
                            <?php if (!$produto) : ?>
                                <td><?=$d->produto_nome?></td>
                            <?php endif ?>
                            <td>
                                <?php if ($permissao["editar"]) : ?>
                                    <a class="edit" href="<?=$router->route("admin.estoque.lote.editar", ["id" => $d->hash])?>"><?=$d->codigo_lote?></a>
                                <?php else : ?>
                                    <span><?=$d->codigo_lote?></span>
                                <?php endif ?>
                            </td>
                            <td><?=!empty($d->data_validade) ? datebr($d->data_validade) : "-"?></td>
                            <td><?=number_format((float) $d->quantidade_atual, 2, ",", ".")?> <?=$d->unidade_medida ?? ""?></td>
                            <?php if ($permissao["editar"] || $permissao["excluir"]) : ?>
                                <td class="text-end actions-column">
                                    <div class="table-actions">
                                        <?php if ($permissao["editar"]) : ?>
                                            <a class="table-action-btn" data-tooltip="true" title="Editar" href="<?=$router->route("admin.estoque.lote.editar", ["id" => $d->hash])?>"><i class="uil-edit-alt"></i></a>
                                        <?php endif ?>
                                        <?php if ($permissao["excluir"]) : ?>
                                            <button type="button" class="table-action-btn table-action-danger" data-tooltip="true" title="Excluir lote" onclick="Delete('estoque/lotes/delete', '<?=$d->hash?>')"><i class="uil uil-trash"></i></button>
                                        <?php endif ?>
                                    </div>
                                </td>
                            <?php endif ?>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
