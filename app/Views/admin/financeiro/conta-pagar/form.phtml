<script>
    var _baixarId = null;

    function baixarParcela(id, vencimento, descricao) {
        _baixarId = id;
        document.getElementById("baixar-parcela-desc").textContent = descricao + " — Venc. " + vencimento;
        document.getElementById("baixar-parcela-data").value = new Date().toISOString().split("T")[0];
        new bootstrap.Modal(document.getElementById("modal-baixar-parcela")).show();
    }

    document.getElementById("btn-confirmar-baixa").addEventListener("click", function () {
        var id = _baixarId;
        var data = new FormData();
        data.append("id", id);
        data.append("data_pagamento", document.getElementById("baixar-parcela-data").value);
        data.append("csrf", "<?=$csrf?>");

        fetch("/financeiro/conta-pagar/baixar", {
            method: "POST",
            body: data
        })
        .then(function (r) { return r.json(); })
        .then(function (resp) {
            if (resp.error) {
                alert(resp.message);
            } else {
                bootstrap.Modal.getInstance(document.getElementById("modal-baixar-parcela")).hide();
                window.location.reload();
            }
        })
        .catch(function () {
            alert("Erro ao baixar parcela.");
        });
    });
</script>
<?php $this->end() ?>
