<script>
    window._gruposData = <?=json_encode($grupos ?? [], JSON_UNESCAPED_UNICODE)?>;

    function abrirDetalheGrupo(key) {
        var g = window._gruposData[key];
        if (!g) return;

        document.getElementById("modal-grupo-titulo").textContent = g.descricao + " — " + g.fornecedor;

        var tbody = document.getElementById("modal-grupo-corpo");
        tbody.innerHTML = "";

        g.itens.forEach(function (item) {
            var tr = document.createElement("tr");
            tr.innerHTML =
                '<td>' + item.parcela_numero + '/' + item.parcela_total + '</td>' +
                '<td>' + new Date(item.data_vencimento + 'T00:00:00').toLocaleDateString("pt-BR") + '</td>' +
                '<td class="text-end">R$ ' + parseFloat(item.valor).toLocaleString("pt-BR", {minimumFractionDigits:2,maximumFractionDigits:2}) + '</td>' +
                '<td>' + (item.data_pagamento ? new Date(item.data_pagamento + 'T00:00:00').toLocaleDateString("pt-BR") : '-') + '</td>' +
                '<td><span class="badge ' + (item.status === 'PAGO' ? 'bg-success' : 'bg-warning') + '">' + (item.status === 'PAGO' ? 'Pago' : 'Pendente') + '</span></td>' +
                '<td class="text-end">' +
                    (item.status !== 'PAGO' ? '<div class="table-actions"><button type="button" class="table-action-btn table-action-success" title="Baixar" onclick="abrirBaixar(\'' + item.id + '\', \'' + item.data_vencimento + '\', \'' + g.descricao + '\', \'pagar\')"><i class="uil uil-check-circle"></i></button></div>' : '') +
                '</td>';
            tbody.appendChild(tr);
        });

        new bootstrap.Modal(document.getElementById("modal-detalhe-grupo")).show();
    }

    function abrirBaixar(id, vencimento, descricao, tipo) {
        document.getElementById("baixar-id").value = id;
        document.getElementById("baixar-descricao").textContent = descricao + " — Venc. " + vencimento;
        document.getElementById("baixar-data").value = new Date().toISOString().split("T")[0];
        new bootstrap.Modal(document.getElementById("modal-baixar")).show();
    }

    document.getElementById("form-baixar").addEventListener("submit", function (e) {
        e.preventDefault();
        var form = this;
        var data = new FormData(form);

        fetch("<?=$router->route("admin.financeiro.conta.pagar.baixar")?>", {
            method: "POST",
            body: data
        })
        .then(function (r) { return r.json(); })
        .then(function (resp) {
            if (resp.error) {
                alert(resp.message);
            } else {
                bootstrap.Modal.getInstance(document.getElementById("modal-baixar")).hide();
                window.location.reload();
            }
        })
        .catch(function () {
            alert("Erro ao baixar conta.");
        });
    });
</script>
