<?php if (!empty($graficoMensal)) : ?>
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Comparativo Mensal</h5>
    </div>
    <div class="card-body">
        <div id="chart-extrato" style="height:350px;"></div>
    </div>
</div>
<script>
    (function() {
        var raw = <?=json_encode($graficoMensal)?>;
        var meses = [], entradas = [], saidas = [];
        raw.forEach(function(r) {
            var d = r.mes.split('-');
            meses.push(d[1] + '/' + d[0]);
            entradas.push(parseFloat(r.entradas));
            saidas.push(parseFloat(r.saidas));
        });
        var chart = echarts.init(document.getElementById('chart-extrato'), null, {locale: 'PT-BR'});
        chart.setOption({
            tooltip: {
                trigger: 'axis',
                valueFormatter: function(v) { return 'R$ ' + Number(v).toLocaleString('pt-BR', {minimumFractionDigits: 2}); }
            },
            legend: { data: ['Entradas', 'Saídas'], bottom: 0 },
            grid: { left: '3%', right: '4%', bottom: '50px', top: '10px', containLabel: true },
            xAxis: {
                type: 'category',
                data: meses,
                axisLabel: { rotate: 30 }
            },
            yAxis: {
                type: 'value',
                axisLabel: {
                    formatter: function(v) { return 'R$ ' + (v / 1000).toFixed(0) + 'k'; }
                }
            },
            series: [
                {
                    name: 'Entradas',
                    type: 'line',
                    data: entradas,
                    smooth: true,
                    lineStyle: { color: '#28a745', width: 3 },
                    itemStyle: { color: '#28a745' },
                    areaStyle: { color: 'rgba(40, 167, 69, 0.1)' }
                },
                {
                    name: 'Saídas',
                    type: 'line',
                    data: saidas,
                    smooth: true,
                    lineStyle: { color: '#dc3545', width: 3 },
                    itemStyle: { color: '#dc3545' },
                    areaStyle: { color: 'rgba(220, 53, 69, 0.1)' }
                }
            ]
        });
        window.addEventListener('resize', function() { chart.resize(); });
    })();
</script>
<?php endif ?>

